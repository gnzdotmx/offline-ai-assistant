# Offline AI Assistant - Git Ignore File

# ===================================
# USER DATA & RUNTIME FILES
# ===================================

# NOTE: User data is stored in ~/.config/ai-offline-assistant/
# Local directories are kept for development/testing purposes

# Vector database and indices
db/
!db/.gitkeep

# Uploaded documents
docs/
!docs/.gitkeep
!docs/README.md

# Application logs
logs/
!logs/.gitkeep

# Downloaded AI models
models/
!models/.gitkeep
!models/README.md

# ===================================
# PYTHON & DEVELOPMENT
# ===================================

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.env
.venv

# PyInstaller
*.manifest
*.spec
installer/

