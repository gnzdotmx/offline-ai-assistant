# ===================================

# pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ===================================
# JUPYTER NOTEBOOKS
# ===================================

.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ===================================
# TEMPORARY & BACKUP FILES
# ===================================

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej

# Log files
*.log
*.out

# ===================================
# CONFIGURATION & SECRETS
# ===================================

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Configuration files with sensitive data
config.local.py
settings.local.py
secrets.py

# ===================================
# PACKAGE MANAGERS
# ===================================

# pip
pip-log.txt
pip-delete-this-directory.txt

# Poetry
poetry.lock

# Pipenv
Pipfile.lock

# ===================================
# DOCUMENTATION BUILD
# ===================================

# Sphinx documentation
docs/_build/
.readthedocs.yml

# MkDocs
site/

# ===================================
# CUSTOM PROJECT EXCLUSIONS
# ===================================

# User-specific model configurations
user_config.py
local_settings.py

# Development and testing files
test_documents/
dev_notes.md
TODO.txt

# Performance profiling
*.prof
*.pstats

# Debugging files
debug.log
trace.log

# Backup databases
*.db.backup
*.sqlite.backup

# Temporary model downloads
*.downloading
*.partial

# ===================================
# KEEP THESE FILES
# ===================================

# Keep directory structure with .gitkeep files
!.gitkeep

# Keep important documentation
!README.md
!SETUP.md
!TECHNICAL_DESIGN.md
!requirements.txt
!LICENSE
!CONTRIBUTING.md

# Keep example configurations
!config.example.py
!settings.example.py

# Keep source code
!offline_ai_assistant/
!offline_ai_assistant/*.py
